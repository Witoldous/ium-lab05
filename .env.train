# Konfiguracja usługi train (docker compose, opcja env_file)
# Dane (katalog data/ montowany z hosta)
DATA_PATH=data/wine.csv
TARGET_COLUMN=target
TEST_SIZE=0.2
RANDOM_SEED=42
# Model (Pipeline: StandardScaler + LogisticRegression)
MAX_ITER=1000
C=1.0
# Powtarzana walidacja krzyżowa 5 x CV_REPEATS (dłuższy trening do obserwacji w docker stats)
CV_REPEATS=1000
N_JOBS=1
# Artefakty (katalog models/ montowany z hosta)
MODEL_PATH=models/model.joblib
RESULTS_PATH=models/wyniki.txt
# Zadanie 6: endpoint /status dla usługi visualize
STATUS_PORT=5000
KEEP_ALIVE=10
